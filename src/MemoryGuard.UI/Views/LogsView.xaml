<UserControl x:Class="MemoryGuard.UI.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             FontFamily="{StaticResource AppFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Card -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="System Activity &amp; Diagnostics Log" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Real-time structured logging of memory monitoring, safety rule verifications, process closures, and system cleans." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📋 Copy" Style="{StaticResource SecondaryButtonStyle}" 
                            Command="{Binding CopyLogsCommand}" Margin="0,0,8,0" Padding="12,6" />
                    <Button Content="📁 Log Folder" Style="{StaticResource SecondaryButtonStyle}" 
                            Command="{Binding OpenLogFolderCommand}" Margin="0,0,8,0" Padding="12,6" />
                    <Button Content="🗑 Clear" Style="{StaticResource SecondaryButtonStyle}" 
                            Command="{Binding ClearLogsCommand}" Margin="0,0,8,0" Padding="12,6" />
                    <Button Content="↻ Refresh" Style="{StaticResource SecondaryButtonStyle}" 
                            Command="{Binding RefreshCommand}" Padding="12,6" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filter & Search Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Filter Level Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Filter:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <RadioButton Content="All" IsChecked="{Binding FilterLevel, Converter={x:Null}, Mode=OneWay}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="ALL"
                                 Style="{StaticResource NavButtonStyle}" Margin="0,0,4,0" Padding="8,4" />
                    <RadioButton Content="Info" Command="{Binding SetFilterCommand}" CommandParameter="INFO"
                                 Style="{StaticResource NavButtonStyle}" Margin="0,0,4,0" Padding="8,4" />
                    <RadioButton Content="Warnings" Command="{Binding SetFilterCommand}" CommandParameter="WARN"
                                 Style="{StaticResource NavButtonStyle}" Margin="0,0,4,0" Padding="8,4" />
                    <RadioButton Content="Errors" Command="{Binding SetFilterCommand}" CommandParameter="ERROR"
                                 Style="{StaticResource NavButtonStyle}" Margin="0,0,4,0" Padding="8,4" />
                </StackPanel>

                <!-- Search Box -->
                <TextBox Grid.Column="1" Style="{StaticResource SearchTextBoxStyle}" 
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="16,0" VerticalAlignment="Center"
                         Tag="Search logs by keyword or category..." />

                <!-- Event Count Status -->
                <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="11" 
                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Logs View List -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="4">
            <ListBox ItemsSource="{Binding FilteredLogs}" 
                     Background="Transparent" 
                     BorderThickness="0" 
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Timestamp -->
                                <TextBlock Grid.Column="0" Text="{Binding Timestamp}" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />

                                <!-- Level Badge -->
                                <Border Grid.Column="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="INFO">
                                                    <Setter Property="Background" Value="#1A38BDF8" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="WARN">
                                                    <Setter Property="Background" Value="#1AFBBF24" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                    <Setter Property="Background" Value="#1AF87171" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Level}" FontSize="10" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="INFO">
                                                        <Setter Property="Foreground" Value="#38BDF8" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="WARN">
                                                        <Setter Property="Foreground" Value="#FBBF24" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                        <Setter Property="Foreground" Value="#F87171" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- Category -->
                                <Border Grid.Column="2" Background="{DynamicResource CardHoverBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Category}" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>

                                <!-- Message -->
                                <TextBlock Grid.Column="3" Text="{Binding Message}" FontSize="12" FontFamily="Consolas, Segoe UI" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
