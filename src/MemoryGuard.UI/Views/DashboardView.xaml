<UserControl x:Class="MemoryGuard.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:MemoryGuard.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             FontFamily="{StaticResource AppFont}">

    <UserControl.Resources>
        <conv:BytesToReadableSizeConverter x:Key="BytesConv" />
        <conv:PercentToBrushConverter x:Key="PercentBrushConv" />
        <conv:RiskToBrushConverter x:Key="RiskBrushConv" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
        <StackPanel Margin="0,0,0,24">
            
            <!-- Hero Memory Card -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Circular Progress Gauge Area -->
                    <Border Grid.Column="0" Width="170" Height="170" 
                            CornerRadius="85"
                            Background="{DynamicResource AppBackgroundBrush}" 
                            BorderBrush="{Binding RamPercent, Converter={StaticResource PercentBrushConv}}"
                            BorderThickness="6"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding RamPercent, StringFormat={}{0:F0}%}" 
                                       FontSize="38" FontWeight="Bold" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" 
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="RAM USED" FontSize="11" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextSecondaryBrush}" 
                                       HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Metrics Details -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="System Memory Status" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="12" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding HealthStatusText}" FontSize="12" FontWeight="SemiBold" 
                                           Foreground="{Binding RamPercent, Converter={StaticResource PercentBrushConv}}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Continuous real-time kernel sampling &amp; memory pressure diagnostics" 
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="USED RAM" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding UsedRamBytes, Converter={StaticResource BytesConv}}" 
                                           FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="AVAILABLE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding AvailableRamBytes, Converter={StaticResource BytesConv}}" 
                                           FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="TOTAL PHYSICAL" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding TotalRamBytes, Converter={StaticResource BytesConv}}" 
                                           FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Action Button -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0">
                        <Button Style="{StaticResource PrimaryButtonStyle}" 
                                Command="{Binding QuickOptimizeCommand}" 
                                Padding="20,12" FontSize="14" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" Margin="0,0,8,0" />
                                <TextBlock Text="Quick Optimize" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                        <Button Content="Recommendations →" 
                                Command="{Binding NavigateQuickOptimizeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="8,4" FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Quick Optimize Feedback Banner -->
            <Border Style="{StaticResource CardStyle}" 
                    Background="{DynamicResource CardHoverBrush}" 
                    BorderBrush="{DynamicResource SuccessBrush}" 
                    Margin="0,0,0,16"
                    Padding="14,10"
                    Visibility="{Binding OptimizationResultText, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding OptimizationResultText}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Secondary Metrics Cards Grid -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Commit Usage Card -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="COMMIT CHARGE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Text="{Binding CommitPercent, StringFormat={}{0:F0}%}" 
                                   FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,2" />
                        <ProgressBar Style="{StaticResource ModernProgressBarStyle}" 
                                     Value="{Binding CommitPercent}" Maximum="100" Margin="0,4,0,8" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="{Binding CommitTotalBytes, Converter={StaticResource BytesConv}}" />
                            <Run Text=" / " />
                            <Run Text="{Binding CommitLimitBytes, Converter={StaticResource BytesConv}}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Memory Pressure Card -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="MEMORY PRESSURE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Text="{Binding PressureLevel}" 
                                   FontSize="22" FontWeight="Bold" 
                                   Foreground="{Binding RamPercent, Converter={StaticResource PercentBrushConv}}" Margin="0,4,0,2" />
                        <TextBlock Text="Windows paging &amp; allocation stress level" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Potentially Reclaimable Card -->
                <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="POTENTIALLY RECLAIMABLE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Text="{Binding EstimatedReclaimableBytes, Converter={StaticResource BytesConv}}" 
                                   FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,2" />
                        <TextBlock Text="Estimated inactive &amp; background memory" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Top Consumers Card -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Top Memory Consumers" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />

                    <ItemsControl ItemsSource="{Binding TopProcesses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>

                                        <!-- PID Pill -->
                                        <Border Grid.Column="0" Background="{DynamicResource CardHoverBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProcessId}" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </Border>

                                        <!-- Process Name & Path -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding SafetyReason}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Memory Usage -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding WorkingSetBytes, Converter={StaticResource BytesConv}}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                            <TextBlock Text="Working Set" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right" />
                                        </StackPanel>

                                        <!-- CPU % -->
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding CpuPercent, StringFormat={}{0:F1}%}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                                            <TextBlock Text="CPU" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
