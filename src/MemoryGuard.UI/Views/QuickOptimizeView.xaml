<UserControl x:Class="MemoryGuard.UI.Views.QuickOptimizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:MemoryGuard.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             FontFamily="{StaticResource AppFont}">

    <UserControl.Resources>
        <conv:BytesToReadableSizeConverter x:Key="BytesConv" />
        <conv:RiskToBrushConverter x:Key="RiskBrushConv" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
        <StackPanel Margin="0,0,0,24">
            
            <!-- Summary Banner Card -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Smart Optimization Recommendations" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Non-destructive optimization engine. Evaluates memory pressure, idle duration, and safety classifications." 
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SAFE ACTIONS FOUND" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding SafeActionsCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ESTIMATED RECLAIMABLE RAM" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding TotalReclaimableRamBytes, Converter={StaticResource BytesConv}}" 
                                           FontSize="24" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="TEMPORARY CACHE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding TotalReclaimableDiskBytes, Converter={StaticResource BytesConv}}" 
                                           FontSize="24" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButtonStyle}" 
                                Command="{Binding ExecuteOptimizationCommand}" 
                                Padding="22,12" FontSize="14" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚀" Margin="0,0,8,0" />
                                <TextBlock Text="Clean &amp; Optimize Selected" FontWeight="Bold" />
                            </StackPanel>
                        </Button>

                        <Button Content="↻ Re-Scan" Style="{StaticResource SecondaryButtonStyle}" 
                                Command="{Binding ScanCommand}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Results Summary Banner (if finished) -->
            <Border Style="{StaticResource CardStyle}" 
                    Background="{DynamicResource CardHoverBrush}" 
                    BorderBrush="{DynamicResource SuccessBrush}" 
                    Margin="0,0,0,16"
                    Visibility="{Binding ResultSummary, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                <StackPanel>
                    <TextBlock Text="Optimization Succeeded" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding ResultSummary}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Selection Actions Bar -->
            <Grid Margin="0,0,0,8">
                <TextBlock Text="Recommended Application Closures (Graceful)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Select All" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SelectAllCommand}" Padding="10,4" Margin="0,0,8,0" />
                    <Button Content="Deselect All" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DeselectAllCommand}" Padding="10,4" />
                </StackPanel>
            </Grid>

            <!-- Recommendations List -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="0">
                <ItemsControl ItemsSource="{Binding Recommendations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Checkbox -->
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0" />

                                    <!-- Process Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Recommendation.ProcessName}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Recommendation.Reason}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- Estimated Reclaim -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Recommendation.EstimatedReclaimBytes, Converter={StaticResource BytesConv}}" 
                                                   FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right" />
                                        <TextBlock Text="Est. Reclaim" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right" />
                                    </StackPanel>

                                    <!-- Idle Duration -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Recommendation.IdleDuration, StringFormat={}{0:%m} min idle}" 
                                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                                        <TextBlock Text="Low Risk" FontSize="10" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Temporary Cache Cleanup Section -->
            <TextBlock Text="Disposable Temporary Caches" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
            <Border Style="{StaticResource CardStyle}" Padding="0">
                <ItemsControl ItemsSource="{Binding CleanupItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding EstimatedSizeBytes, Converter={StaticResource BytesConv}}" 
                                                   FontWeight="Bold" FontSize="13" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding FileCount, StringFormat={}{0:N0} files}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
