<UserControl x:Class="MemoryGuard.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:MemoryGuard.Core.Models;assembly=MemoryGuard.Core"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="900"
             FontFamily="{StaticResource AppFont}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
        <StackPanel Margin="0,0,0,24">
            
            <!-- Header Card -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Application Settings &amp; Preferences" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Configure monitoring frequency, system pressure thresholds, and behavior." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Reset Defaults" Style="{StaticResource SecondaryButtonStyle}" 
                                Command="{Binding ResetDefaultsCommand}" Margin="0,0,8,0" />
                        <Button Content="Save Settings" Style="{StaticResource PrimaryButtonStyle}" 
                                Command="{Binding SaveCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Save Confirmation Message -->
            <TextBlock Text="{Binding SaveMessage}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Margin="6,0,0,12" />

            <!-- System Behavior Card -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Windows Integration &amp; System Tray" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14" />

                    <CheckBox Content="Launch MemoryGuard automatically when Windows starts" 
                              IsChecked="{Binding LaunchOnStartup}" 
                              Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />

                    <CheckBox Content="Minimize to System Tray instead of closing application" 
                              IsChecked="{Binding MinimizeToTray}" 
                              Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />

                    <CheckBox Content="Start minimized in System Tray on Windows boot" 
                              IsChecked="{Binding StartMinimizedToTray}" 
                              Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />

                    <CheckBox Content="Enable Global Keyboard Shortcuts (Ctrl+Alt+M to open, Ctrl+Alt+Shift+M to optimize)" 
                              IsChecked="{Binding GlobalShortcutsEnabled}" 
                              Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />

                    <CheckBox Content="Show desktop notifications for high memory pressure events" 
                              IsChecked="{Binding NotificationsEnabled}" 
                              Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Monitoring Thresholds Card -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Memory Pressure Thresholds" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14" />

                    <!-- Warning Threshold -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Warning Threshold" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Triggers elevated state" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <Slider Grid.Column="1" Minimum="60" Maximum="85" Value="{Binding WarningThreshold}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding WarningThreshold, StringFormat={}{0:F0}%}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- High Pressure Threshold -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="High Pressure Threshold" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Recommends idle app closure" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <Slider Grid.Column="1" Minimum="80" Maximum="95" Value="{Binding HighThreshold}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding HighThreshold, StringFormat={}{0:F0}%}" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Critical Threshold -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Critical Threshold" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Severe system RAM starvation" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <Slider Grid.Column="1" Minimum="90" Maximum="99" Value="{Binding CriticalThreshold}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding CriticalThreshold, StringFormat={}{0:F0}%}" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Idle Timeout -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Application Idle Timeout" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Time before app considered idle" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <Slider Grid.Column="1" Minimum="10" Maximum="120" Value="{Binding IdleTimeoutMinutes}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding IdleTimeoutMinutes, StringFormat={}{0} m}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Theme & Appearance Card -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Theme &amp; Appearance" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14" />

                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Dark Mode" IsChecked="{Binding IsDarkTheme}" 
                                     Style="{StaticResource NavButtonStyle}" Margin="0,0,12,0" />
                        <RadioButton Content="Light Mode" IsChecked="{Binding IsLightTheme}" 
                                     Style="{StaticResource NavButtonStyle}" Margin="0,0,12,0" />
                        <RadioButton Content="Follow Windows Theme" IsChecked="{Binding IsSystemTheme}" 
                                     Style="{StaticResource NavButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
