<UserControl x:Class="MemoryGuard.UI.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:MemoryGuard.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             FontFamily="{StaticResource AppFont}">

    <UserControl.Resources>
        <conv:BytesToReadableSizeConverter x:Key="BytesConv" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
        <StackPanel Margin="0,0,0,24">
            
            <!-- Header Card -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="System &amp; Application Cache Cleaner" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Scans only known safe disposable locations. Preserves downloads, personal documents, browser credentials, and source code." 
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,14" />

                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,32,0">
                                <TextBlock Text="TOTAL TEMPORARY FILES" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding TotalFileCount, StringFormat={}{0:N0} files}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="RECLAIMABLE DISK SPACE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding TotalSizeBytes, Converter={StaticResource BytesConv}}" 
                                           FontSize="20" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButtonStyle}" 
                                Command="{Binding CleanSelectedCommand}" 
                                Padding="20,12" FontSize="14" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧹" Margin="0,0,8,0" />
                                <TextBlock Text="Clean Selected" FontWeight="Bold" />
                            </StackPanel>
                        </Button>

                        <Button Content="↻ Re-Scan" Style="{StaticResource SecondaryButtonStyle}" 
                                Command="{Binding ScanCommand}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Results Summary -->
            <Border Style="{StaticResource CardStyle}" 
                    Background="{DynamicResource CardHoverBrush}" 
                    BorderBrush="{DynamicResource SuccessBrush}" 
                    Margin="0,0,0,16"
                    Visibility="{Binding ResultSummary, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                <TextBlock Text="{Binding ResultSummary}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
            </Border>

            <!-- Progress Text -->
            <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,8" />

            <!-- Cleanable Locations List -->
            <Border Style="{StaticResource CardStyle}" Padding="0">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,14,0" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Item.Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Item.Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding Item.TargetPath}" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Item.EstimatedSizeBytes, Converter={StaticResource BytesConv}}" 
                                                   FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding Item.FileCount, StringFormat={}{0:N0} files}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
