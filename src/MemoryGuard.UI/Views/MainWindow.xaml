<Window x:Class="MemoryGuard.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MemoryGuard.UI.ViewModels"
        xmlns:views="clr-namespace:MemoryGuard.UI.Views"
        xmlns:conv="clr-namespace:MemoryGuard.UI.Converters"
        mc:Ignorable="d"
        Title="MemoryGuard" Height="740" Width="1100" MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/MemoryGuard;component/Resources/app.ico"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">

    <Window.Resources>
        <conv:PercentToBrushConverter x:Key="PercentBrushConv" />

        <!-- View DataTemplates for automatic ViewModel mapping -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProcessExplorerViewModel}">
            <views:ProcessExplorerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuickOptimizeViewModel}">
            <views:QuickOptimizeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanupViewModel}">
            <views:CleanupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StartupViewModel}">
            <views:StartupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}">
            <views:LogsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- App Brand & Title -->
                <StackPanel Grid.Row="0" Margin="18,22,18,24" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/MemoryGuard;component/Resources/app.png" 
                               Width="38" Height="38" 
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MemoryGuard" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="v1.0.0 Commercial" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Row="1" Margin="6,0">
                    <RadioButton Content="📊  Dashboard" IsChecked="{Binding IsDashboardTab}" GroupName="NavGroup"
                                 Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateDashboardCommand}" />
                    <RadioButton Content="⚡  Quick Optimize" IsChecked="{Binding IsQuickOptimizeTab}" GroupName="NavGroup"
                                 Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateQuickOptimizeCommand}" />
                    <RadioButton Content="⚙  Process Explorer" IsChecked="{Binding IsProcessesTab}" GroupName="NavGroup"
                                 Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateProcessesCommand}" />
                    <RadioButton Content="🧹  Temp Cleaner" IsChecked="{Binding IsCleanupTab}" GroupName="NavGroup"
                                 Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCleanupCommand}" />
                    <RadioButton Content="🚀  Startup Apps" IsChecked="{Binding IsStartupTab}" GroupName="NavGroup"
                                 Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateStartupCommand}" />
                    <RadioButton Content="🛠  Settings" IsChecked="{Binding IsSettingsTab}" GroupName="NavGroup"
                                 Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateSettingsCommand}" />
                    <RadioButton Content="📜  Activity Logs" IsChecked="{Binding IsLogsTab}" GroupName="NavGroup"
                                 Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateLogsCommand}" />
                </StackPanel>

                <!-- Sidebar Footer Status -->
                <Border Grid.Row="2" Margin="14,0,14,16" Padding="12" CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}">
                    <StackPanel>
                        <TextBlock Text="SYSTEM STATUS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="8" Height="8" Fill="{Binding HeaderRamPercent, Converter={StaticResource PercentBrushConv}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding HeaderHealthText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Right Content Host Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Active Tab Title -->
                    <TextBlock Grid.Column="0" Text="{Binding CurrentTab}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />

                    <!-- Live RAM Badge & Optimize shortcut -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12,5" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="RAM: " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding HeaderRamPercent, StringFormat={}{0:F0}%}" 
                                           FontWeight="Bold" FontSize="12" 
                                           Foreground="{Binding HeaderRamPercent, Converter={StaticResource PercentBrushConv}}" />
                            </StackPanel>
                        </Border>

                        <Button Content="Quick Optimize" Style="{StaticResource PrimaryButtonStyle}" 
                                Command="{Binding NavigateQuickOptimizeCommand}" Padding="12,6" FontSize="12" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Dynamic View Content -->
            <Border Grid.Row="1" Padding="24,20">
                <ContentControl Content="{Binding CurrentViewModel}" />
            </Border>
        </Grid>
    </Grid>
</Window>
